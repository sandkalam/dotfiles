#!/bin/sh

# usage: import-gsettings
config="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini"
if [ ! -f "$config" ]; then exit 1; fi
if ! command -v gsettings >/dev/null 2>&1; then exit 0; fi

gnome_schema="org.gnome.desktop.interface"
gtk_theme=""
icon_theme=""
cursor_theme=""
font_name=""

while IFS='=' read -r key value; do
    case "$key" in
        gtk-theme-name) gtk_theme=$value ;;
        gtk-icon-theme-name) icon_theme=$value ;;
        gtk-cursor-theme-name) cursor_theme=$value ;;
        gtk-font-name) font_name=$value ;;
    esac
done < "$config"

set_if_changed() {
    setting_key=$1
    setting_value=$2

    [ -n "$setting_value" ] || return 0

    current=$(gsettings get "$gnome_schema" "$setting_key" 2>/dev/null || true)
    desired="'$setting_value'"

    if [ "$current" != "$desired" ]; then
        gsettings set "$gnome_schema" "$setting_key" "$setting_value"
    fi
}

set_if_changed gtk-theme "$gtk_theme"
set_if_changed icon-theme "$icon_theme"
set_if_changed cursor-theme "$cursor_theme"
set_if_changed font-name "$font_name"
